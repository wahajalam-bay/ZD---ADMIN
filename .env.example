# ── Zameen Admin Properties — environment ──────────────────────────────────
# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
#
#   cp .env.example .env
#
# Generate BETTER_AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Public URL the app is served from. Must match what the browser uses, or
# sign-in fails the cross-origin check.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ── Database (PostgreSQL 18) ───────────────────────────────────────────────
# Must be a UTF-8 database: PropOne carries Urdu and Arabic names.
#   docker compose: postgres://zameen:<POSTGRES_PASSWORD>@postgres:5432/zameen_admin
#   local dev helper (pnpm db:dev): postgres://zameen:zameen@localhost:5544/zameen_admin
DATABASE_URL=postgres://zameen:zameen@localhost:5544/zameen_admin

# ── Session signing ────────────────────────────────────────────────────────
# REQUIRED. At least 16 characters; 32 random bytes recommended.
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=

# ── Media storage ──────────────────────────────────────────────────────────
# Checklist evidence and progress photographs are stored on disk, not in an
# object store. In production this MUST be an absolute path to a volume that
# survives container replacement — the app refuses to start otherwise.
# Back it up together with the database (docs/backup-and-restore.md).
#   docker compose: /var/lib/zameen/media   (the `media` volume)
STORAGE_MEDIA_PATH=.data/storage

# ── PropOne integration ────────────────────────────────────────────────────
# "file"     — no live connection; the dashboard shows honest empty states
# "redshift" — read-only sync from the PropOne warehouse over the pg wire
# "api"      — reserved; requires a published PropOne API contract
PROPONE_MODE=file

# Only when PROPONE_MODE=redshift. Obtain from the data platform team — these
# are real credentials, keep them out of version control and CI logs.
#   postgres://<user>:<password>@<cluster-host>:5439/<database>
PROPONE_REDSHIFT_URL=
PROPONE_REDSHIFT_SCHEMA=

# Only when PROPONE_MODE=api. No endpoint contract has been published yet.
PROPONE_API_BASE_URL=
PROPONE_API_TOKEN=

# ── Development seeding ────────────────────────────────────────────────────
# Password given to the clearly-labelled DEMO accounts created by
# `pnpm db:seed:demo`. Leave empty in production; demo accounts must not exist
# on a real deployment.
SEED_DEMO_PASSWORD=

# ── docker compose only ────────────────────────────────────────────────────
# Read by docker-compose.yml to provision the database container.
POSTGRES_USER=zameen
POSTGRES_PASSWORD=
POSTGRES_DB=zameen_admin
APP_PORT=3000
