# ── Application ────────────────────────────────────────────────────────────────
# Public origin the app is served from (used for auth callbacks and links).
APP_URL=http://localhost:3000

# ── Database (PostgreSQL 18) ───────────────────────────────────────────────────
# Local docker-compose default: postgres://zameen:zameen@localhost:5432/zameen_admin
DATABASE_URL=postgres://zameen:zameen@localhost:5432/zameen_admin

# ── Better Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (MUST be unique per environment)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# ── Object storage ─────────────────────────────────────────────────────────────
# STORAGE_DRIVER: "s3" (AWS S3 / Cloudflare R2 / MinIO) or "local" (dev fallback,
# writes to STORAGE_LOCAL_PATH on disk — never use "local" in production).
STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=.data/storage

# S3-compatible settings (docker-compose MinIO defaults shown):
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zameen-admin-media
S3_ACCESS_KEY_ID=zameen-minio
S3_SECRET_ACCESS_KEY=zameen-minio-secret
S3_FORCE_PATH_STYLE=true

# ── Seeding (development only) ─────────────────────────────────────────────────
# Password assigned to seeded demo accounts by `pnpm db:seed:demo`.
# Demo accounts are for local development only — never seed demo data in prod.
SEED_DEMO_PASSWORD=ZameenDev!2026

# ── PropOne integration (external — pending real specification) ────────────────
# Mode: "file" (CSV import via /admin/integrations) or "api" (requires the
# fields below once the real PropOne API specification is provided).
PROPONE_MODE=file
PROPONE_API_BASE_URL=
PROPONE_API_TOKEN=
